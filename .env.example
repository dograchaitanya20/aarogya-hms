# Aarogya HMS - Environment Configuration Template
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
HOSPITAL_TZ=Asia/Kolkata

# Database configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aarogya_hms
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aarogya_hms_test

# JWT Authentication (min 32 chars required)
JWT_SECRET=dev-jwt-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=8h
COOKIE_SECRET=dev-cookie-secret-key-change-in-production

# Logging
LOG_LEVEL=info
