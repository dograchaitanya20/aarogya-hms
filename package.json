{
  "name": "aarogya-hms",
  "version": "1.0.0",
  "description": "Aarogya HMS - Hospital Management System",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm --workspace=backend run dev",
    "start": "npm --workspace=backend run start",
    "migrate": "npm --workspace=backend run migrate",
    "seed": "npm --workspace=backend run seed",
    "test": "npm --workspace=backend run test",
    "demo:race": "npm --workspace=backend run demo:race",
    "docs:openapi": "npm --workspace=backend run docs:openapi",
    "lint": "npm --workspace=backend run lint",
    "dev:web": "npm --workspace=frontend run dev",
    "build:web": "npm --workspace=frontend run build",
    "test:web": "npm --workspace=frontend run test"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
